{
  "title": "Yankee Doodle",
  "description": "A delightful rendition of Yankee Doodle for children.",
  "tags": [
    "kids",
    "children",
    "music"
  ],
  "lyrics": [
    {
      "text": "Yankee Doodle went to town,",
      "start": 5.0,
      "end": 9.0
    },
    {
      "text": "A-riding on a pony,",
      "start": 10.0,
      "end": 14.0
    },
    {
      "text": "Stuck a feather in his cap,",
      "start": 15.0,
      "end": 19.0
    },
    {
      "text": "And called it macaroni.",
      "start": 20.0,
      "end": 24.0
    },
    {
      "text": "Yankee Doodle, keep it up,",
      "start": 25.0,
      "end": 29.0
    },
    {
      "text": "Yankee Doodle dandy,",
      "start": 30.0,
      "end": 34.0
    },
    {
      "text": "Mind the music and the step,",
      "start": 35.0,
      "end": 39.0
    },
    {
      "text": "And with the girls be handy.",
      "start": 40.0,
      "end": 44.0
    }
  ]
}